---
import Base from '../layouts/Base.astro';
import ShaderBg from '../components/ShaderBg.astro';
import AgentLoop from '../components/AgentLoop.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { site, cta } from '../site';
import { homeFaq } from '../data/faq';
import { faqSchema } from '../data/schema';

const title = 'Cogmorphic: Agentic AI Consulting for Business and You';
const description = 'Hand off the routine and go further. Cogmorphic sets up AI agents in the tools you already use. Book a free AI audit.';

const leaks = [
  ['New service idea', 'On hold for months'],
  ['Customers want more', 'No time to offer it'],
  ['A new market', 'Never researched'],
  ['Partnership lead', 'Still in the inbox'],
];
const icon = {
  fast: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9.5 2.5h5"/>',
  track: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="m3.5 6 1.2 1.2L6.8 5M3.5 12l1.2 1.2L6.8 11M3.5 18l1.2 1.2L6.8 17"/>',
  spot: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
  launch: '<path d="M11 3.5c.6 4.2 2.3 5.9 6.5 6.5-4.2.6-5.9 2.3-6.5 6.5-.6-4.2-2.3-5.9-6.5-6.5 4.2-.6 5.9-2.3 6.5-6.5z"/><path d="M18.5 15v5M16 17.5h5"/>',
  grow: '<path d="M4 19h16"/><path d="M7 15l4-4 3 3 5-6"/><path d="M15 8h4v4"/>',
};
const outcomes = [
  ['fast', 'Move first', 'Act on chances while they’re fresh.'],
  ['spot', 'Spot openings', 'Agents surface leads and trends.'],
  ['launch', 'Launch new offers', 'Try ideas, same team.'],
  ['grow', 'Grow revenue', 'More sales, no extra overhead.'],
];
const tool = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  cal: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  apps: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  sensor: '<circle cx="12" cy="12" r="2"/><path d="M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8"/>',
};
const works = [['mail', 'Email'], ['cal', 'Calendar'], ['apps', 'Your software'], ['sensor', 'Sensors and devices']];
const svg = (paths: string) => `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">${paths}</svg>`;
---
<Base title={title} description={description} schema={[faqSchema(homeFaq)]}>
  <section class="hero" aria-labelledby="hero-title">
    <ShaderBg variant="hero" />
    <div class="wrap">
      <h1 id="hero-title" class="label">AI agent setup for businesses and individuals</h1>
      <p class="display"><span class="line">Hand off the routine.</span> <span class="line">Go&nbsp;<span class="rough" data-rough="hero">further</span>.</span></p>
      <p class="lede">Cogmorphic sets up AI agents in the tools you already use, so your time goes to new opportunities.</p>
      <div class="hero__actions">
        <a class="btn" href={cta.href}>{cta.label}</a>
        <a class="textlink" href="#what">See how it works <span aria-hidden="true">↓</span></a>
      </div>
      <p class="trust"><span>Free {site.callLength} call</span> · <span>No tech skills needed</span></p>
    </div>
  </section>

  <section class="section" aria-labelledby="need">
    <div class="wrap split split--need">
      <div>
        <h2 id="need" class="label">Sound familiar?</h2>
        <p class="statement">Big opportunities wait while the day fills up.</p>
      </div>
      <ul class="pile" aria-label="Opportunities waiting for time">
        {leaks.map(([what, state]) => <li><span>{what}</span><em>{state}</em></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="what">
    <div class="wrap">
      <h2 id="what" class="label">What is an AI agent?</h2>
      <p class="statement">Cruise control for your work.</p>
      <p class="lede statement__sub">It does the steady tasks in your tools. You&nbsp;steer.</p>
      <AgentLoop />
    </div>
  </section>

  <section class="section" aria-labelledby="gains">
    <div class="wrap">
      <h2 id="gains" class="label">What opens up for you</h2>
      <ul class="gains">
        {outcomes.map(([k, h, p]) => (
          <li><span class="gains__icon" set:html={svg(icon[k as keyof typeof icon])} /><h3>{h}</h3><p>{p}</p></li>
        ))}
      </ul>
      <div class="works mt-40">
        <p class="works__label">Works with what you already use</p>
        <ul class="works__list">
          {works.map(([k, name]) => <li><span set:html={svg(tool[k as keyof typeof tool])} />{name}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="vs">
    <div class="wrap">
      <h2 id="vs" class="label">AI agent vs. phone menu vs. chatbot</h2>
      <ul class="compare">
        <li><h3>Phone menu</h3><p>Sends the call somewhere.</p><span class="compare__tag">Routes</span></li>
        <li><h3>Chatbot</h3><p>Answers a question.</p><span class="compare__tag">Talks</span></li>
        <li class="is-agent"><h3>AI agent</h3><p>Does the work, then checks with you.</p><span class="compare__tag">Gets it done</span></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="how">
    <div class="wrap">
      <h2 id="how" class="label">How Cogmorphic works with you</h2>
      <ol class="steps">
        <li><h3>Free call</h3><p>We find your biggest openings.</p></li>
        <li><h3>We set it up</h3><p>In your tools. Nothing new to learn.</p></li>
        <li><h3>You stay in charge</h3><p>You approve <span class="rough" data-rough="underline">what matters</span>.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq">
    <div class="wrap">
      <h2 id="faq" class="label">Questions</h2>
      <Faq items={homeFaq} />
    </div>
  </section>

  <script>
    // Hand-drawn marks from Rough Notation (MIT). Purely decorative: drawn once when each comes into view.
    import { annotate } from 'rough-notation';
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const style = {
      hero: { type: 'underline', color: '#ffb000', strokeWidth: 3, padding: 2, iterations: 1 },
      underline: { color: '#ffb000', strokeWidth: 2, padding: 2, iterations: 1 },
    } as const;
    const marks = Array.from(document.querySelectorAll<HTMLElement>('[data-rough]'));
    const draw = (el: HTMLElement) => {
      const key = el.dataset.rough as keyof typeof style;
      annotate(el, { type: 'underline', animate: !still, animationDuration: 900, ...style[key] }).show();
      document.querySelectorAll('svg.rough-annotation:not([aria-hidden])').forEach((s) => s.setAttribute('aria-hidden', 'true'));
    };
    if (!('IntersectionObserver' in window)) marks.forEach(draw);
    else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); setTimeout(() => draw(e.target as HTMLElement), 250); } });
      }, { threshold: 0.8 });
      const start = () => marks.forEach((m) => io.observe(m));
      document.fonts?.ready ? document.fonts.ready.then(start) : start();
    }
  </script>

  <FinalCta heading="See what an agent could do for you." />
</Base>
