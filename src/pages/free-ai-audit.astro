---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { site } from '../site';
import { faqSchema, breadcrumbs } from '../data/schema';

const path = '/free-ai-audit/';
const title = 'Free AI Audit: Find Where AI Agents Fit, Cogmorphic';
const description = 'A free video call and a written list of your top three openings for AI agents, from time saved to new revenue. No obligation.';
const faq = [
  { q: 'Is the AI audit really free?', a: `Yes. The ${site.callLength} call and the one-page report are free, with no obligation to buy anything after.` },
  { q: 'What is an AI readiness assessment?', a: 'It is a look at how you work today and where AI agents would save you the most time. The free AI audit is a short, practical version: it names your top three opportunities and what each would take.' },
  { q: 'What do I need to prepare?', a: 'Nothing formal. Think of the tasks you or your team repeat every week, and which tools you use for them.' },
  { q: 'Do you need access to my accounts for the audit?', a: 'No. The audit is a conversation. Nobody needs your logins to tell you where agents fit.' },
];
const schema = [
  breadcrumbs([{ name: 'Free AI audit', path }]),
  {
    '@type': 'WebPage',
    name: 'Free AI audit',
    url: new URL(path, site.url).href,
    description,
    about: { '@id': `${site.url}/#service` },
  },
  faqSchema(faq),
];
const formLive = Boolean(site.web3formsKey);
const formEndpoint = 'https://api.web3forms.com/submit';
// Works with a Google Calendar booking page or a Cal.com link.
// Google's embed link (calendar.google.com/calendar/appointments/schedules/...) shows the
// calendar in the page; any other Google link (e.g. calendar.app.google/...) opens in a new tab.
// A value that isn't a valid https URL falls back to the placeholder, with a build warning.
let bookingUrl: URL | null = null;
const bookingRaw = (site.bookingUrl || '').trim();
if (bookingRaw) {
  try {
    bookingUrl = new URL(bookingRaw);
    if (bookingUrl.protocol !== 'https:') throw new Error('not https');
  } catch {
    bookingUrl = null;
    console.warn(`[free-ai-audit] site.bookingUrl is not a valid https URL: "${bookingRaw}". Showing the placeholder.`);
  }
}
const bookingLive = Boolean(bookingUrl);
const bookingHost = bookingUrl?.hostname ?? '';
const isGoogleEmbed = bookingHost === 'calendar.google.com' && bookingUrl!.pathname.includes('/appointments/schedules/');
const isGoogleLink = !isGoogleEmbed && (bookingHost === 'calendar.app.google' || bookingHost === 'calendar.google.com');
let bookingEmbedSrc = '';
if (bookingUrl && !isGoogleLink) {
  const u = new URL(bookingUrl.href);
  if (isGoogleEmbed) u.searchParams.set('gv', 'true');
  else { u.searchParams.set('embed', 'true'); u.searchParams.set('theme', 'dark'); }
  bookingEmbedSrc = u.href;
}
---
<Base title={title} description={description} schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Free AI audit</nav>
      <h1>Your free AI audit</h1>
      <p class="lede">A free {site.callLength} video call to find where AI agents could save time and open new revenue, then a written list of your top three openings.</p>
      <a class="btn" href="#book">Book my free audit</a>
      <p class="trust"><span>Free</span> · <span>No obligation</span> · <span>For businesses and individuals</span></p>
    </div>
  </section>

  <section class="section" aria-labelledby="check">
    <div class="wrap">
      <h2 id="check" class="label">What the audit covers</h2>
      <div class="rows">
        <div class="row-item"><h3>What we check</h3><p>The steps you repeat, the tools you use and the handoffs between them, response times, and which tasks an AI agent could take.</p></div>
        <div class="row-item"><h3>What you get</h3><p>A one-page report with your top three openings, what each would cost, and what you can do yourself.</p></div>
        <div class="row-item"><h3>What it costs</h3><p>Nothing. No obligation to buy anything after.</p></div>
      </div>
    </div>
  </section>

  <section class="section" id="book" aria-labelledby="book-heading">
    <div class="wrap split split--top">
      <div>
        <h2 id="book-heading" class="label">Book your free AI audit</h2>
        <form class="form" method="POST" action={formLive ? formEndpoint : undefined} data-form-live={formLive ? 'true' : 'false'}>
          {!formLive && (
            <p class="notice" role="note"><strong>Placeholder:</strong> form not connected yet. Add the Web3Forms access key in src/site.ts.</p>
          )}
          <div class="row">
            <label for="f-name">Name<input id="f-name" name="name" autocomplete="name" required /></label>
            <label for="f-email">Email<input id="f-email" name="email" type="email" autocomplete="email" required /></label>
          </div>
          <div class="row">
            <label for="f-business">Business (optional)<input id="f-business" name="business" autocomplete="organization" /></label>
            <label for="f-phone">Phone (optional)<input id="f-phone" name="phone" type="tel" autocomplete="tel" /></label>
          </div>
          <div class="row">
            <label for="f-website">Website (optional)<input id="f-website" name="website" type="url" inputmode="url" placeholder="https://" /></label>
            <label for="f-time">Best time to call
              <select id="f-time" name="best_time">
                <option>Morning</option>
                <option>Midday</option>
                <option>Afternoon</option>
                <option>Evening</option>
              </select>
            </label>
          </div>
          {formLive && <input type="hidden" name="access_key" value={site.web3formsKey} />}
          <input type="hidden" name="subject" value="New free AI audit request" />
          <input type="hidden" name="from_name" value="Cogmorphic website" />
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
          <p class="actions"><button class="btn" type="submit">Send and pick a time</button></p>
          <p class="note">Used only to arrange your audit. <a href="/privacy/">Privacy</a></p>
          <div role="status"><p class="notice" data-form-status hidden></p></div>
        </form>
      </div>
      <div class={bookingEmbedSrc ? 'booking booking--frame' : 'booking'} id="calendar">
        {bookingLive && isGoogleLink ? (
          <div>
            <p class="booking__title">Pick a time that suits you</p>
            <a class="btn" href={bookingUrl!.href} target="_blank" rel="noopener">Open the calendar <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        ) : bookingLive ? (
          <iframe src={bookingEmbedSrc} title="Book a free AI audit" loading="lazy" class={isGoogleEmbed ? 'booking__frame booking__frame--light' : 'booking__frame'} />
        ) : (
          <div>
            <p class="notice"><strong>Placeholder:</strong> booking calendar goes here.</p>
            <p class="muted mt-20">Add your booking link in src/site.ts.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="audit-faq">
    <div class="wrap">
      <h2 id="audit-faq" class="label">Free AI audit: questions</h2>
      <Faq items={faq} />
      <p class="muted mt-40">Read more about <a href="/ai-agents-for-business/">AI agents for business</a> or <a href="/personal-ai-agents/">personal AI agents</a>.</p>
    </div>
  </section>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('form[data-form-live]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    status.hidden = false;
    if (form.dataset.formLive !== 'true') {
      status.textContent = 'This form is a placeholder and did not send. It will work once the form service is connected.';
      return;
    }
    status.textContent = 'Sending...';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.success === false) throw new Error();
      form.reset();
      status.textContent = 'Thanks, got it. Now pick a time in the calendar.';
      document.getElementById('calendar')?.scrollIntoView({ behavior: 'smooth' });
    } catch {
      status.textContent = 'Sorry, that did not send. Please try again in a moment.';
    }
  });
</script>
